<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Checkout can save the customer's address: reload the widget JWT (see ProfileChangedObserver) -->
    <event name="customer_save_commit_after">
        <observer name="profileChangedTrueLoyal" instance="TrueLoyal\LoyaltyRewards\Observer\Customer\ProfileChangedObserver" />
    </event>
    <event name="customer_address_save_commit_after">
        <observer name="profileChangedTrueLoyal" instance="TrueLoyal\LoyaltyRewards\Observer\Customer\ProfileChangedObserver" />
    </event>
    <event name="customer_address_delete_commit_after">
        <observer name="profileChangedTrueLoyal" instance="TrueLoyal\LoyaltyRewards\Observer\Customer\ProfileChangedObserver" />
    </event>
</config>
