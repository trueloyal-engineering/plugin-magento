<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--Create customer attribute from api-->
    <preference for="TrueLoyal\LoyaltyRewards\Api\CustomerAttributeInterface" type="TrueLoyal\LoyaltyRewards\Model\Api\CustomerAttribute"/>

    <!--Update customer attribute from api-->
    <preference for="TrueLoyal\LoyaltyRewards\Api\CustomerAttributeUpdateInterface" type="TrueLoyal\LoyaltyRewards\Model\Api\CustomerAttributeUpdate"/>

    <type name="Magento\Checkout\CustomerData\DefaultItem">
        <plugin name="trueloyal_add" type="TrueLoyal\LoyaltyRewards\Plugin\Checkout\CustomerData\AroundPluginDefaultItem" disabled="false" sortOrder="10"/>
    </type>
    <!--Disable quantity box on checkout/cart page-->
    <type name="Magento\Checkout\Block\Cart\AbstractCart">
        <plugin name="item-disable-qty" type="TrueLoyal\LoyaltyRewards\Plugin\Cart\DisableQty" sortOrder="1"/>
    </type>

    <type name="TrueLoyal\LoyaltyRewards\Model\MemberIdResolver">
        <arguments>
            <argument name="logger" xsi:type="object">TrueLoyal\LoyaltyRewards\Logger\Logger</argument>
        </arguments>
    </type>

    <type name="TrueLoyal\LoyaltyRewards\Model\Reward\RewardService">
        <arguments>
            <argument name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <!-- Adding log file for TrueLoyal log -->
    <type name="TrueLoyal\LoyaltyRewards\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="TrueLoyal\LoyaltyRewards\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">trueloyalLog</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">TrueLoyal\LoyaltyRewards\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
