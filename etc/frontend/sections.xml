<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <!-- The widget JWT carries the name, billing address and opt-in. Login, logout and store/currency switches
         already invalidate every section. -->
    <action name="customer/account/editPost">
        <section name="trueloyal"/>
    </action>
    <action name="customer/address/formPost">
        <section name="trueloyal"/>
    </action>
    <action name="customer/address/delete">
        <section name="trueloyal"/>
    </action>
</config>
